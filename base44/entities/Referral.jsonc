{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_id": {
      "type": "string",
      "description": "ID of the user who made the referral"
    },
    "referred_id": {
      "type": "string",
      "description": "ID of the user who was referred"
    },
    "referral_code": {
      "type": "string",
      "description": "The referral code used"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "rewarded"
      ],
      "default": "pending",
      "description": "Status of the referral"
    },
    "completion_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date when referral was completed (first promotion engagement)"
    },
    "reward_amount": {
      "type": "number",
      "default": 10,
      "description": "Reward amount for successful referral"
    },
    "promotion_id": {
      "type": "string",
      "description": "ID of the first promotion the referred user engaged with"
    }
  },
  "required": [
    "referrer_id",
    "referred_id",
    "referral_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "referrer_id": "{{user.id}}"
        },
        {
          "referred_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "referrer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}