{
  "name": "CheckIn",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the user who checked in"
    },
    "campaign_id": {
      "type": "string",
      "description": "ID of the campaign being checked into"
    },
    "business_id": {
      "type": "string",
      "description": "ID of the business"
    },
    "qr_code_id": {
      "type": "string",
      "description": "ID of the QR code that was scanned"
    },
    "location_latitude": {
      "type": "number",
      "description": "Latitude where check-in occurred"
    },
    "location_longitude": {
      "type": "number",
      "description": "Longitude where check-in occurred"
    },
    "check_in_time": {
      "type": "string",
      "format": "date-time",
      "description": "When the check-in occurred"
    },
    "device_info": {
      "type": "string",
      "description": "Basic device information for analytics"
    },
    "status": {
      "type": "string",
      "enum": [
        "valid",
        "failed"
      ],
      "default": "valid",
      "description": "Status of the check-in attempt"
    },
    "failure_reason": {
      "type": "string",
      "description": "Reason for a failed check-in"
    }
  },
  "required": [
    "user_id",
    "campaign_id",
    "business_id",
    "qr_code_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "business_id": "{{user.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}