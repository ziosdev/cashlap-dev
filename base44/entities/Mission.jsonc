{
  "name": "Mission",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID of the business"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the user"
    },
    "campaign_id": {
      "type": "string",
      "description": "ID of the campaign this mission belongs to"
    },
    "title": {
      "type": "string",
      "description": "Mission title"
    },
    "description": {
      "type": "string",
      "description": "Mission description"
    },
    "reward_amount": {
      "type": "number",
      "description": "Base reward amount for completing mission"
    },
    "final_reward_amount": {
      "type": "number",
      "description": "Final reward amount after applying influencer multiplier"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "submitted",
        "approved",
        "rejected"
      ],
      "default": "active",
      "description": "Mission status"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date mission proof was submitted"
    },
    "submission_url": {
      "type": "string",
      "description": "URL to social media post"
    },
    "submission_screenshot_url": {
      "type": "string",
      "description": "URL to uploaded screenshot of post"
    },
    "submission_notes": {
      "type": "string",
      "description": "Optional notes from the player"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason for rejection from the business owner"
    },
    "review_text": {
      "type": "string",
      "description": "User review of the business"
    },
    "rating": {
      "type": "number",
      "description": "User rating (1-5)"
    },
    "submission_location_latitude": {
      "type": "number",
      "description": "Latitude where mission was submitted"
    },
    "submission_location_longitude": {
      "type": "number",
      "description": "Longitude where mission was submitted"
    },
    "submission_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Exact timestamp of mission submission"
    }
  },
  "required": [
    "business_id",
    "user_id",
    "campaign_id",
    "title",
    "reward_amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "business_id": "{{user.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "business_id": "{{user.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}